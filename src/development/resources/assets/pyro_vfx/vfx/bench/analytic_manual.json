{
  "format": "pyro_vfx:1",
  "metadata": {"author": "Pyro VFX", "description": "GPU birth cohorts triggered manually through effect timeline events"},
  "lifetime": {"mode": "once", "active_ticks": 180},
  "events": {"burst": {"type": "emit", "emitter": "main"}},
  "triggers": [
    {"type": "on_creation", "event": "burst"},
    {"type": "timeline", "time_ticks": 15, "event": "burst"},
    {"type": "timeline", "time_ticks": 30, "event": "burst"},
    {"type": "timeline", "time_ticks": 45, "event": "burst"},
    {"type": "timeline", "time_ticks": 60, "event": "burst"},
    {"type": "timeline", "time_ticks": 75, "event": "burst"},
    {"type": "timeline", "time_ticks": 90, "event": "burst"},
    {"type": "timeline", "time_ticks": 105, "event": "burst"},
    {"type": "timeline", "time_ticks": 120, "event": "burst"}
  ],
  "emitters": [{
    "id": "main",
    "emitter_lifetime": {"mode": "manual"},
    "spawn_amount": {"mode": "manual", "amount": 50},
    "spawn_shape": {"type": "sphere", "radius": 1.5},
    "particle_lifetime": {"max_age_ticks": 35},
    "motion": {"mode": "dynamic", "dynamic": {"direction": "outward", "speed": 0.9,
      "acceleration": [0, -0.1, 0], "linear_drag": 0.2}},
    "rotation": {"mode": "none"},
    "render": {"type": "sprite", "facing": "camera", "environment_lighting": false,
      "sprite": {"texture": "minecraft:textures/particle/generic_0.png", "blend_mode": "additive"},
      "color": [0.35, 0.8, 1, "1.0 - particle.normalized_age"],
      "scale": [0.16, 0.16, 1]}
  }]
}
