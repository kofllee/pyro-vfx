{
  "format": "pyro_vfx:1",
  "metadata": {
    "author": "Pyro VFX",
    "description": "Museum / CPU / GPU / NEW GPU orbit: GPU Analytic moves an entire cohort along an age-driven parametric orbit. Use the stand's INFO button for technical details and comparison labels."
  },
  "parameters": {
    "count": 70
  },
  "lifetime": {
    "mode": "once",
    "active_ticks": 160
  },
  "emitters": [
    {
      "id": "orbit",
      "emitter_lifetime": {
        "mode": "once",
        "active_ticks": 1
      },
      "spawn_amount": {
        "mode": "instant",
        "amount": "param.count"
      },
      "spawn_shape": {
        "type": "sphere",
        "radius": 1.55
      },
      "particle_lifetime": {
        "max_age_ticks": 140
      },
      "motion": {
        "mode": "parametric",
        "parametric": {
          "offset": [
            "math.sin(particle.age * 0.14) * 2.0",
            "math.cos(particle.age * 0.09) * 1.2",
            "math.sin(particle.age * 0.07) * 1.3"
          ]
        }
      },
      "rotation": {
        "mode": "none"
      },
      "render": {
        "type": "sprite",
        "facing": "camera",
        "environment_lighting": false,
        "sprite": {
          "texture": "minecraft:textures/particle/generic_0.png",
          "blend_mode": "additive"
        },
        "color": [
          1,
          0.55,
          0.2,
          "1-particle.normalized_age*0.8"
        ],
        "scale": [
          0.64,
          0.64,
          1
        ]
      }
    }
  ]
}
