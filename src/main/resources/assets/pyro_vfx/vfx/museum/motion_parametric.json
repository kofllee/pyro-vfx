{
  "format": "pyro_vfx:1",
  "metadata": {
    "author": "Pyro VFX",
    "description": "Museum / Motion / Parametric orbit: Particles follow an age-driven analytic orbit around their spawn point. Read on-stand controls to replay and compare."
  },
  "parameters": {
    "count": 40
  },
  "lifetime": {
    "mode": "once",
    "active_ticks": 160
  },
  "emitters": [
    {
      "id": "main",
      "emitter_lifetime": {
        "mode": "once",
        "active_ticks": 1
      },
      "spawn_amount": {
        "mode": "instant",
        "amount": "param.count"
      },
      "spawn_shape": {
        "type": "ring",
        "radius": 1.2,
        "inner_radius": 1.1
      },
      "offset": [
        0,
        0,
        0
      ],
      "particle_lifetime": {
        "max_age_ticks": 140
      },
      "motion": {
        "mode": "parametric",
        "parametric": {
          "offset": [
            "math.cos(particle.age * 0.12) * 1.2",
            "math.sin(particle.age * 0.16) * 0.7",
            "math.sin(particle.age * 0.12) * 1.2"
          ],
          "direction": [
            0,
            1,
            0
          ]
        }
      },
      "rotation": {
        "mode": "none"
      },
      "render": {
        "type": "sprite",
        "facing": "camera",
        "environment_lighting": false,
        "sprite": {
          "texture": "minecraft:textures/particle/generic_0.png",
          "blend_mode": "additive"
        },
        "color": "#FFAA33FF",
        "scale": [
          0.9,
          0.9,
          1
        ]
      }
    }
  ]
}
