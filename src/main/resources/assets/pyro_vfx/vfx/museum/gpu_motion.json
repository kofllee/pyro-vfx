{
  "format": "pyro_vfx:1",
  "metadata": {
    "author": "Pyro VFX",
    "description": "Museum / Expressions / Motion formulas: Particle position and velocity formulas. Read on-stand controls to replay and compare."
  },
  "parameters": {
    "count": 42
  },
  "lifetime": {
    "mode": "once",
    "active_ticks": 160
  },
  "emitters": [
    {
      "id": "main",
      "emitter_lifetime": {
        "mode": "once",
        "active_ticks": 1
      },
      "spawn_amount": {
        "mode": "instant",
        "amount": "param.count"
      },
      "spawn_shape": {
        "type": "sphere",
        "radius": 1.55
      },
      "particle_lifetime": {
        "max_age_ticks": 140
      },
      "motion": {
        "mode": "dynamic",
        "dynamic": {
          "direction": "outward",
          "speed": 0.2,
          "acceleration": [
            0,
            -0.06,
            0
          ],
          "linear_drag": 0.2
        }
      },
      "rotation": {
        "mode": "none"
      },
      "render": {
        "type": "sprite",
        "facing": "camera",
        "environment_lighting": false,
        "sprite": {
          "texture": "minecraft:textures/particle/generic_0.png",
          "blend_mode": "additive"
        },
        "color": [
          "0.5 + math.abs(math.sin(spawn.pos.z * 0.05)) * 0.5",
          "0.3 + math.abs(particle.vel.x) * 0.15",
          0.7,
          "1.0 - particle.normalized_age * 0.7"
        ],
        "scale": [
          "(0.3 + math.abs(math.sin(particle.pos.x * 0.05)) * 0.08) * 5",
          "(0.3 + math.abs(math.sin(particle.prev_pos.x * 0.05)) * 0.08) * 5",
          1
        ]
      }
    }
  ]
}
