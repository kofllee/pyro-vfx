{
  "format": "pyro_vfx:1",
  "metadata": {
    "author": "Pyro VFX",
    "description": "GPU additive sprite sheet with 4 animated frames and packed instance UVs"
  },
  "parameters": {
    "count": 1000
  },
  "lifetime": {
    "mode": "once",
    "active_ticks": 160
  },
  "emitters": [
    {
      "id": "main",
      "emitter_lifetime": {
        "mode": "once",
        "active_ticks": 1
      },
      "spawn_amount": {
        "mode": "instant",
        "amount": "param.count"
      },
      "spawn_shape": {
        "type": "sphere",
        "radius": 3
      },
      "offset": [
        0,
        0,
        0
      ],
      "particle_lifetime": {
        "max_age_ticks": 140
      },
      "motion": {
        "mode": "static"
      },
      "rotation": {
        "mode": "none"
      },
      "render": {
        "type": "sprite",
        "facing": "camera",
        "environment_lighting": false,
        "sprite": {
          "texture": "minecraft:textures/particle/generic_0.png",
          "blend_mode": "additive",
          "uv": {
            "mode": "animated",
            "texture_size": [
              16,
              16,
              0
            ],
            "uv_start": [
              0,
              0,
              0
            ],
            "uv_size": [
              4,
              16,
              0
            ],
            "uv_step": [
              4,
              0,
              0
            ],
            "frame_count": 4,
            "fps": 8,
            "stretch_to_lifetime": false,
            "loop": true,
            "random_start_frame": false
          }
        },
        "color": "#FFAA33FF",
        "scale": [
          0.18,
          0.18,
          1
        ]
      }
    }
  ]
}
