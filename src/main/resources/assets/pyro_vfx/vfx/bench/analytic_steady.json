    "particle_lifetime":{"max_age_ticks":40},
    "motion":{"mode":"dynamic","dynamic":{"direction":"outward","speed":0.5,"acceleration":[0,-0.8,0],"linear_drag":0.3}},
    "render":{"type":"sprite","environment_lighting":false,
      "sprite":{"texture":"minecraft:textures/particle/generic_0.png","blend_mode":"additive"},
      "color":[1,0.65,0.15,"curve.fade(particle.normalized_age)"],
      "scale":["0.1+particle.normalized_age*0.2","0.1+particle.normalized_age*0.2",1]}
