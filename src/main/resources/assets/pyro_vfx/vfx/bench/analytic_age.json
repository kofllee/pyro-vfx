{
  "format": "pyro_vfx:1",
  "metadata": {
    "author": "Pyro VFX",
    "description": "GPU shared-age uniform appearance, no per-particle CPU appearance updates"
  },
  "parameters": { "count": 1000 },
  "lifetime": { "mode": "once", "active_ticks": 160 },
  "emitters": [
    {
      "id": "main",
      "emitter_lifetime": { "mode": "once", "active_ticks": 1 },
      "spawn_amount": { "mode": "instant", "amount": "param.count" },
      "spawn_shape": { "type": "sphere", "radius": 3 },
      "particle_lifetime": { "max_age_ticks": 140 },
      "motion": { "mode": "dynamic", "dynamic": {
        "direction": "outward", "speed": 0.75,
        "acceleration": [0,-1.0,0], "linear_drag": 0.6
      }},
      "rotation": { "mode": "none" },
      "render": {
        "type": "sprite",
        "facing": "camera",
        "environment_lighting": false,
        "sprite": {
          "texture": "minecraft:textures/particle/generic_0.png",
          "blend_mode": "additive"
        },
        "color": [1.0, 0.7, 0.3, "1.0 - 0.7 * particle.normalized_age"],
        "scale": ["0.12 + 0.25 * particle.normalized_age",
                  "0.12 + 0.25 * particle.normalized_age", 1]
      }
    }
  ]
}